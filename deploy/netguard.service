[Unit]
Description=NetGuard DNS/DHCP filter
After=network-online.target
Wants=network-online.target

[Service]
User=netguard
WorkingDirectory=/opt/netguard
ExecStart=/opt/netguard/netguard -config /opt/netguard/config.yaml
Restart=on-failure
# Bind ports 53/67 and send DHCP broadcasts without running as root
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_NET_BROADCAST
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_NET_BROADCAST
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/netguard/data

[Install]
WantedBy=multi-user.target
